<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lia Rarasari - Portofolio</title>
    <link rel="stylesheet" href="css/style.css">
</head>

<body>

    <!-- Navigasi -->
    <nav>
        <div class="container">
            <div class="logo">Lia Rarasari</div>

            <ul class="nav-links">
                <li><a href="index.html" class="active">Home</a></li>
                <li><a href="about.html">About</a></li>
                <li><a href="contact.html">Contact</a></li>
            </ul>
        </div>
    </nav>

    <!-- Hero -->
    <section class="hero">
        <div class="container hero-container">

            <div class="hero-content">

                <p class="small-text">
                    WELCOME TO MY PORTFOLIO
                </p>

                <h1>
                    Hello, I'm
                    <span>Lia Rarasari</span>
                </h1>

                <h2>
                    <span id="typing-text"></span>
                </h2>

                <p class="hero-description">
                    Mahasiswa Sistem Informasi yang sedang belajar,
                    berkarya, dan berkembang melalui teknologi.
                </p>

                <div class="hero-buttons">

                    <a href="#projects" class="btn">
                        Lihat Proyek
                    </a>

                    <a href="contact.html" class="btn btn-outline">
                        Hubungi Saya
                    </a>

                </div>

            </div>

            <div class="hero-image">

                <div class="flower flower-one">✿</div>
                <div class="flower flower-two">✿</div>
                <div class="flower flower-three">✿</div>

                <div class="cute-star star-one">✦</div>
                <div class="cute-star star-two">✧</div>

                <div class="cute-heart heart-one">♡</div>
                <div class="cute-heart heart-two">♥</div>

                <div class="cute-sparkle sparkle-one">✦</div>
                <div class="cute-sparkle sparkle-two">✧</div>

                <div class="image-circle">

                    <img
                        src="images/profile.jpeg"
                        alt="Foto Lia Rarasari"
                    >

                </div>

                <div class="decorative-heart">
                    ♡
                </div>

            </div>

        </div>
    </section>

    <!-- Tentang Singkat -->
    <section class="intro-section">

        <div class="container">

            <p class="section-label">
                A LITTLE ABOUT ME
            </p>

            <h2>
                Belajar, berkarya, dan terus
                <span>berkembang.</span>
            </h2>

            <p>
                Saya adalah mahasiswa Sistem Informasi yang tertarik
                dengan pengembangan website, desain antarmuka,
                dan berbagai hal yang berhubungan dengan teknologi.
            </p>

            <a href="about.html" class="text-link">
                Kenal lebih dekat →
            </a>

        </div>

    </section>

    <!-- Proyek -->
    <section class="projects" id="projects">

        <div class="container">

            <p class="section-label">
                MY WORK
            </p>

            <h2>
                Proyek yang Saya Kerjakan
            </h2>

            <p class="section-description">
                Beberapa proyek dan latihan yang saya kerjakan selama
                belajar Sistem Informasi dan pengembangan website.
            </p>

            <div
                class="project-grid"
                id="project-grid"
            >
                <!-- Data proyek diisi oleh JavaScript -->
            </div>

        </div>

    </section>

    <footer>

        <div class="container">

            <p>
                Made with love by Lia Rarasari
            </p>

            <p>
                &copy; 2026 Lia Rarasari
            </p>

        </div>

    </footer>

    <script src="js/main.js?v=2"></script>

</body>
</html>